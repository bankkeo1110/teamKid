From 4bedb003257be4854a987007578ec84ed37e8c61 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 10:07:42 +0700
Subject: [PATCH 4/6] 4.1.3: reachability reads the release README in projects
 without one

---
 RELEASE-NOTES.md                      |  9 +++++++++
 VERSION                               |  2 +-
 harness/scripts/check-reachability.py | 19 +++++++++++++++++++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/RELEASE-NOTES.md b/RELEASE-NOTES.md
index 91f7a9a..255ab1e 100644
--- a/RELEASE-NOTES.md
+++ b/RELEASE-NOTES.md
@@ -1,3 +1,12 @@
+# Astragentic 4.1.3
+
+**Team KID fork.** `check-reachability.py` in an adapted project now reads the method's role table
+from the applied release's README when the project's own root README does not carry one (a
+greenfield project has no README, and check 1 failed on every fresh install). Also carried in this
+fork since 4.1.2: `install.sh` uses a portable in-place sed (GNU and BSD), and the dispatch mod's
+TDD gate allocates its scratch directory with a template GNU `mktemp` accepts — on Linux and WSL
+the old call refused every Builder commit.
+
 # Astragentic 4.1.2
 
 **Team KID fork of 4.1.1.** The representative role is renamed from Thomas to **KID** everywhere it is
diff --git a/VERSION b/VERSION
index 4d0dcda..de197cc 100644
--- a/VERSION
+++ b/VERSION
@@ -1 +1 @@
-4.1.2
+4.1.3
diff --git a/harness/scripts/check-reachability.py b/harness/scripts/check-reachability.py
index 17d02f3..8d7314c 100755
--- a/harness/scripts/check-reachability.py
+++ b/harness/scripts/check-reachability.py
@@ -72,6 +72,25 @@ SKILL_GLOBS = [
     os.path.join(PAYLOAD, ".agents", "skills", "*", "SKILL.md"),
 ]
 README = os.path.join(ROOT, "README.md")
+# Team KID (4.1.3): in an adapted project the root README is the PROJECT's and rarely carries the
+# method table; fall back to the README of the release the project applied (or staged).
+if LAYOUT == "project":
+    def _has_method(p):
+        try:
+            return "## The method" in open(p, encoding="utf-8").read()
+        except OSError:
+            return False
+    if not _has_method(README):
+        for _f in (os.path.join(ROOT, ".astraler", "state", "applied-version"),
+                   os.path.join(ROOT, ".astraler", "CANDIDATE")):
+            try:
+                _v = open(_f, encoding="utf-8").read().strip()
+            except OSError:
+                continue
+            _r = os.path.join(ROOT, ".astraler", "releases", _v, "README.md")
+            if _v and _has_method(_r):
+                README = _r
+                break
 PROMPT = os.path.join(ROOT, "prompts", "ADAPT-HARNESS.md")
 
 # A plugin skill is addressed as `<plugin>:<skill>` — that qualified form is what a typed
-- 
