#!/usr/bin/env bash
# kid [project] — start KID (Team KID's representative) for a project in your home folder.
#   kid             the project you are in; else the only one; else a menu
#   kid shop-app    that project
# Model and effort come from the kid row of the project's .agents/orchestrator.md.
proj=""
if [ $# -gt 0 ] && [ -f "$HOME/$1/.claude/agents/kid.md" ]; then
  proj="$HOME/$1"; shift
else
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  main="${common%/.git}"
  if [ -n "$common" ] && [ -f "$main/.claude/agents/kid.md" ]; then
    proj="$main"
  else
    mapfile -t ps < <(kid-projects)
    if [ ${#ps[@]} -eq 0 ]; then echo "Chưa có dự án Team KID nào. Tạo bằng: new-kid-project <tên>"; exit 1
    elif [ ${#ps[@]} -eq 1 ]; then proj="$HOME/${ps[0]}"
    else
      echo "Chọn dự án cho KID:"; PS3="Số: "
      select p in "${ps[@]}"; do [ -n "${p:-}" ] && { proj="$HOME/$p"; break; }; done
      [ -n "$proj" ] || exit 1
    fi
  fi
fi
cd "$proj" || exit 1
row="$(awk -F'|' '$2 ~ /^ *kid *$/ {gsub(/ /,"",$4); gsub(/ /,"",$5); print $4" "$5; exit}' .agents/orchestrator.md)"
model="${row%% *}"; effort="${row##* }"
printf '\033[1;36mKID → %s\033[0m\n' "$(basename "$proj")"
exec claude --dangerously-skip-permissions --agent kid --model "${model:-claude-opus-5-5}" --effort "${effort:-medium}" "$@"
