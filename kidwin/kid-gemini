#!/usr/bin/env bash
# kid-gemini — Gemini in Team KID, through Google's Antigravity CLI (agy). Google stopped serving
# personal accounts on the old Gemini CLI (Oct 2026); agy is its replacement for them.
#   kid-gemini --setup [project…]   install agy, sign in once, then let each Developer hand the code
#                                    typing to a Gemini junior (saves Claude tokens; the Developer reviews)
#   kid-gemini --off [project…]     Developers type alone again
#   kid-gemini [project]            Claude is out of tokens: open agy in the project to keep going
#                                    yourself (no team, no gates — just you and Gemini)
#   kid-gemini --repair             re-apply the setup where it is on (kid-update runs this)
set -euo pipefail
RT=antigravity
TPL="$HOME/.teamkid/project-template/gemini"
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
die()  { printf '  \033[31m✘\033[0m %s\n' "$*"; exit 1; }
say_() { printf '\n\033[1;36m▸ %s\033[0m\n' "$*"; }
MODE=run; ps=()
for a in "$@"; do case "$a" in --setup) MODE=setup ;; --off) MODE=off ;; --repair) MODE=repair ;; -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; *) ps+=("$a") ;; esac; done
export PATH="$HOME/.local/bin:$PATH"
all() { kid-projects 2>/dev/null || "$(dirname "$0")/kid-projects"; }
junior_row() { awk '/^## Junior/{on=1;next} /^## /{on=0} on && /^\| *builder *\|/ {split($0,c,"|"); r=c[3]; gsub(/ /,"",r); print r; exit}' "$1"; }
set_row() {  # set_row <orchestrator.md> <runtime>
  awk -v rt="$2" '/^## Junior/{on=1} /^## / && !/^## Junior/{on=0}
    on && /^\| *builder *\|/ { print "| builder | " rt " | | |"; next } { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}
need_cli() {
  command -v agy >/dev/null && return
  say_ "Cài Antigravity CLI (agy)"
  curl -fsSL https://antigravity.google/cli/install.sh | bash >/dev/null && command -v agy >/dev/null && ok "$(agy --version 2>/dev/null | head -1)" \
    || die "Không cài được agy. Thử tay: curl -fsSL https://antigravity.google/cli/install.sh | bash"
}
works() { timeout 120 agy -p "Reply with the single word OK." </dev/null 2>/dev/null | grep -q OK; }

apply() {  # apply <project>: files the Builder's dispatch-junior needs, then the Junior row
  local root="$HOME/$1" f="$HOME/$1/.agents/orchestrator.md" changed=0
  [ -f "$f" ] || { warn "bỏ qua $1: không thấy .agents/orchestrator.md"; return; }
  [ -d "$root/.agents/roles" ] && ! cmp -s "$TPL/junior-$RT.md" "$root/.agents/roles/junior-$RT.md" && { cp "$TPL/junior-$RT.md" "$root/.agents/roles/"; changed=1; }
  for s in "$root/.claude/skills/dispatch-junior/SKILL.md" "$root/.agents/skills/dispatch-junior/SKILL.md"; do
    [ -f "$s" ] && ! grep -q "^$RT → herdr agent start" "$s" || continue
    # the launcher matrix is the first ```text block after "## 2."; add our line at its end
    python3 - "$s" "$TPL/launch.md" <<'PY'
import sys; p, l = sys.argv[1], open(sys.argv[2]).read()
s = open(p).read(); i = s.find('## 2.'); j = s.find('```text', i); k = s.find('```', j + 7)
if i < 0 or j < 0 or k < 0: sys.exit('no launcher block')
open(p, 'w').write(s[:k] + '\n' + l + s[k:])
PY
    changed=1
  done
  [ "$(junior_row "$f")" = $RT ] || { set_row "$f" $RT; changed=1; }
  if [ $changed = 1 ]; then
    git -C "$root" add .agents .claude/skills/dispatch-junior 2>/dev/null || true
    git -C "$root" commit -q -m "Team KID: Developers hand code typing to a Gemini junior (Antigravity CLI)" && ok "$1: Dev giao phần gõ code cho Gemini"
  else ok "$1: đã bật"; fi
}

case "$MODE" in
  setup)
    need_cli
    if ! works; then
      say_ "Đăng nhập Google cho agy (một lần)"
      echo "  agy sẽ mở. Đăng nhập tài khoản Google có gói Gemini (nếu có link + mã: mở link, dán mã lại)."
      echo "  Thấy ô nhập tin nhắn là xong, gõ  /quit  (hoặc Ctrl+C hai lần) để thoát."
      read -rp "  Nhấn Enter để mở… " _
      agy || true
      works || die "agy chưa trả lời được. Chạy  agy  thử tay, rồi chạy lại: kid-gemini --setup"
    fi
    ok "agy đã đăng nhập và trả lời được"
    [ ${#ps[@]} -gt 0 ] || mapfile -t ps < <(all)
    for p in "${ps[@]}"; do apply "$p"; done
    echo "  Ticket giao sau lúc này sẽ dùng Gemini. Tắt: kid-gemini --off" ;;
  repair)
    command -v agy >/dev/null || exit 0
    for p in $(all); do f="$HOME/$p/.agents/orchestrator.md"; [ -f "$f" ] && [ "$(junior_row "$f")" = $RT ] && apply "$p"; done; true ;;
  off)
    [ ${#ps[@]} -gt 0 ] || mapfile -t ps < <(all)
    for p in "${ps[@]}"; do f="$HOME/$p/.agents/orchestrator.md"; [ -f "$f" ] || continue
      set_row "$f" none; git -C "$HOME/$p" commit -q -m "Team KID: Developers type alone" -- .agents/orchestrator.md 2>/dev/null && ok "$p: Dev tự gõ code" || ok "$p: đã tắt"; done ;;
  run)
    need_cli
    p="${ps[0]:-}"
    if [ -z "$p" ]; then mapfile -t list < <(all)
      [ ${#list[@]} -eq 1 ] && p="${list[0]}" || { PS3="Số: "; echo "Chọn dự án:"; select x in "${list[@]}"; do [ -n "${x:-}" ] && { p="$x"; break; }; done; }
    fi
    cd "$HOME/$p" || die "Không thấy dự án $p"
    printf '\033[1;36mGemini (agy) → %s\033[0m  (dự phòng khi Claude hết token: không có team, không có cổng kiểm soát)\n' "$p"
    exec agy -i "Claude is out of tokens, so you are standing in for the Team KID project in this folder until it is back. Read CLAUDE.md, AGENTS.md and .astraler/ledger.md if present, then run: gh issue list --state open --limit 20, git status, git worktree list. Tell me in Vietnamese, briefly, what is in progress and what you suggest doing next. Do not push, merge, close issues or remove worktrees unless I ask; work on a branch, never on main." ;;
esac
